      <!-- ESTILOS ESPECÍFICOS PARA LA REJILLA RESPONSIVE -->
      <style>
        .media-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        @media (min-width: 900px) {
          .media-grid {
            grid-template-columns: 1fr 1fr;
          }
        }
      </style>
      <div class="hero-buttons">
        <a href="/contact" class="btn btn-primary">CONECTAR</a>
        <a href="/projects" class="btn btn-secondary">VER PROYECTOS</a>
      </div>
      
      <Footer />
    </main>
  </div>
